# ─── Required ────────────────────────────────────────────────────────────────

# Unique identifier for this physical station (e.g. grip_strength, balance_board)
STATION_ID=grip_strength

# Base URL of the Strivex server API
SERVER_URL=http://192.168.1.10:3000

# Shared secret used to authenticate this station with the server
STATION_KEY=change-me-station-secret

# ─── Adapter ─────────────────────────────────────────────────────────────────
# Controls how the gateway communicates with the game hardware/software.
#   mock        – auto-generates a random result after a short delay (dev/demo)
#   manual      – results driven via the UI Simulate panel (integration testing)
#   serial      – real MCU connected via USB serial port
#   gameserver  – game is controlled over a local WebSocket (GAME_WS_URL)
ADAPTER=mock

# Serial adapter settings (only used when ADAPTER=serial)
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# WebSocket URL of the local game-control server (only used when ADAPTER=gameserver)
GAME_WS_URL=ws://127.0.0.1:4200

# ─── Timing ──────────────────────────────────────────────────────────────────

# How often the gateway sends a heartbeat to the server (milliseconds)
HEARTBEAT_MS=30000

# Maximum time to wait for a game result before marking it as timed-out (ms)
GAME_TIMEOUT_MS=120000

# ─── Storage ─────────────────────────────────────────────────────────────────

# Directory for crash-safe outbox and in-flight game state (relative to gateway/)
DATA_DIR=./data

# ─── UI ──────────────────────────────────────────────────────────────────────

# Port for the local log/observability web UI (bound to 127.0.0.1 only)
GATEWAY_UI_PORT=4100
